@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontSize 12
skinparam arrowColor #444444
skinparam componentBackgroundColor #EEF2FF
skinparam componentBorderColor #6366F1
skinparam databaseBackgroundColor #FEF3C7
skinparam databaseBorderColor #D97706
skinparam packageBackgroundColor #F8F9FA
skinparam packageBorderColor #CCCCCC
skinparam linetype ortho

title Service NSW — Current POC

package "Tier 1 — Azure Suggester" #FFF7ED {
  database "search-index\n(Azure AI Search)" as primary #FEF3C7
  [Built-in Suggester] as suggester
  primary -down-> suggester
}

package "Tier 0 — OpenAI Pipeline" {
  [Extract Titles & Sections] as extract
  [OpenAI Model] as llm
  [Ingest] as ingest
}

[MiniSearch\n(in-memory)] as mini #D1FAE5

actor "User" as user

package "Service API (Node.js CF)" {
  [GET /suggestions] as api
}

primary -down-> extract
extract -down-> llm
llm     -down-> ingest
ingest  -down-> mini

user      -down-> api
api       -down-> mini
api       -down-> suggester
mini      -up-> api
suggester -up-> api
api       -up-> user

@enduml
